{
  "name": "@bb-plugin-studio/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "bb-plugin-studio": "bun apps/cli/src/bin.ts",
    "dev": "bun --filter @bb-plugin-studio/workbench dev",
    "build": "bun --filter '*' build",
    "check": "bun --filter '*' check && tsc -p scripts/tsconfig.json && bun run compatibility:check",
    "compatibility:check": "bun scripts/compatibility-check.ts",
    "compatibility:latest": "bun scripts/check-latest-bb.ts",
    "test": "bun run test:unit",
    "test:unit": "bun --filter '*' test && bun test scripts",
    "visual:test": "bun --filter @bb-plugin-studio/workbench visual:test && bun --filter bb-plugin-studio visual:test",
    "visual:update": "bun --filter @bb-plugin-studio/workbench visual:update && bun --filter bb-plugin-studio visual:update",
    "package:artifact": "bun scripts/build-plugin-studio-package.ts",
    "package:inspect": "bun scripts/plugin-studio-package-clean-room.ts",
    "package:test": "bun scripts/plugin-studio-package-clean-room.ts",
    "plugin-studio:package:build": "bun scripts/build-plugin-studio-package.ts",
    "plugin-studio:package:test": "bun scripts/plugin-studio-package-clean-room.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^26.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
