{
  "name": "bb-plugin-mate",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bb": ">=0.36.0",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Plugin Studio",
    "description": "Build, inspect, and preview bb plugins.",
    "branding": {
      "icon": "Toolbox"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/plugin-workbench"
    ]
  },
  "files": [
    "BUN_LICENSE.md",
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "runtime/darwin-arm64/bb-mate",
    "runtime/darwin-arm64/manifest.json",
    "skills/plugin-workbench/SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "bb plugin build .",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "package:artifact": "bun ../../scripts/build-mate-package.ts",
    "test": "bun test src",
    "types": "bb plugin types .",
    "types:check": "bb plugin types . --check",
    "visual:test": "bb plugin build . && playwright test --config visual/playwright.config.ts",
    "visual:update": "bb plugin build . && playwright test --config visual/playwright.config.ts --update-snapshots=all"
  },
  "devDependencies": {
    "@bb-mate/runtime": "workspace:*",
    "@axe-core/playwright": "4.12.1",
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.36.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
