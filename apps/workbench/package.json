{
  "name": "@bb-mate/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && bun --bun vite build && bun run stories:build",
    "check": "tsc --noEmit",
    "check:surface-catalog": "bun scripts/plugin-surface-declarations.ts",
    "stories": "ladle serve",
    "stories:build": "ladle build",
    "stories:preview": "ladle preview",
    "visual:test": "bun run stories:build && playwright test",
    "visual:update": "bun run stories:build && playwright test --update-snapshots",
    "test": "bun test --preload ./src/test-dom.ts src"
  },
  "dependencies": {
    "@bb-mate/inspection": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@happy-dom/global-registrator": "^18.0.1",
    "@ladle/react": "5.1.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
