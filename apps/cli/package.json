{
  "name": "@bb-plugin-studio/cli",
  "private": true,
  "version": "0.1.0-alpha.3",
  "description": "Build, inspect, and preview bb plugins.",
  "homepage": "https://github.com/galligan/bb-plugin-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galligan/bb-plugin-studio.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/galligan/bb-plugin-studio/issues"
  },
  "license": "MIT",
  "keywords": [
    "bb",
    "plugin-development",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "bb-plugin-studio": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "pluginStudio": {
    "runtime": "Bun",
    "nativeHost": "macOS",
    "fixtureCi": "Linux"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@bb-plugin-studio/inspection": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2"
  }
}
